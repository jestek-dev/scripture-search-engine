node_modules/
dist/
*.tsbuildinfo

# Build artifacts are GitHub Release assets, never Git objects.
# Only the reviewed descriptor in artifacts/*.json is committed.
output/
*.db
*.db-wal
*.db-shm
*.db.building
*.db.candidate

# Source corpora are fetched by manifest, checksummed, and never committed.
pipeline/sources/
pipeline/.cache/

**/.scratch/

# Gauntlet run output (the committed baseline lives in eval/baselines/)
eval/.runs/

# Workbench's downloaded artifact (the *.db rule above catches the database;
# this keeps partial downloads and any metadata out too)
workbench/.artifact/
workbench/.state/
workbench/test-results/

# Extracted source texts (the zips beside them carry the checksums)
pipeline/sources/vpl/
pipeline/sources/clarke/
pipeline/sources/kjv/

# macOS Finder metadata
.DS_Store
