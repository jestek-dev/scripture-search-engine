{
  "name": "@jestek-dev/scripture-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dev-only curation workbench: judges the verified release artifact on localhost. Never published, never shipped to a consumer.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fetch-artifact": "tsx src/fetchArtifact.ts",
    "serve": "tsx src/server.ts",
    "compile-judgments": "tsx src/compileJudgments.ts"
  },
  "dependencies": {
    "@jestek-dev/scripture-artifact-client": "*",
    "@jestek-dev/scripture-engine": "*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
