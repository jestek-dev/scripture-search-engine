{
  "name": "@lh/scripture-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build-time only. Admits sources, aligns passages, computes statistics, and emits the fingerprinted content artifact. Never shipped to a consumer.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:fixture": "tsx src/buildFixtureDb.ts",
    "build:artifact": "tsx src/buildArtifact.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@lh/scripture-engine": "*",
    "yaml": "2.8.1"
  }
}
